{
  "expo": {
    "name": "BPD Capture",
    "slug": "bpd-capture",
    "version": "1.4.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.blueprintdigital.bpdcapture",
      "versionCode": 9,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "BPD Capture uses the camera to photograph and video job sites for each CE order.",
          "microphonePermission": "BPD Capture records audio with job videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "BPD Capture saves a backup copy of job photos and videos to your gallery.",
          "savePhotosPermission": "BPD Capture saves a backup copy of job photos and videos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-mail-composer",
      "react-native-zip-archive",
      "expo-secure-store",
      "react-native-compressor",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Outfit",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Outfit_300Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/Outfit_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Outfit_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Outfit_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Outfit_300Light.ttf",
              "./assets/fonts/Outfit_400Regular.ttf",
              "./assets/fonts/Outfit_500Medium.ttf",
              "./assets/fonts/Outfit_600SemiBold.ttf"
            ]
          }
        }
      ]
    ]
  }
}